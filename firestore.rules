rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clients only read. Every write goes through Cloud Functions (admin SDK).
    // Signed-in devices only (anonymous sign-in happens before the app renders).
    // Real names and the raw interview are kept in cardPrivate, which no client can read.
    match /cards/{id} {
      allow read: if request.auth != null && resource.data.status == 'published';
    }
    match /questions/{id} {
      allow read: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
